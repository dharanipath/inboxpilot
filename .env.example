# InboxPilot settings. Copy this file to ".env" in the same folder as docker-compose.yml and fill in
# the three REQUIRED values in section 1.
#   macOS / Linux / Git Bash:  cp .env.example .env
#   Windows PowerShell:        Copy-Item .env.example .env
# Never commit ".env": it holds secrets (.gitignore keeps it out of git).

# =============================================================================
# 1. REQUIRED: sign in with Gmail (read-only). Step by step: README, "Step 3".
# =============================================================================
# From Google Cloud -> Credentials -> your OAuth client (ends with .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored Google sign-in. 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# =============================================================================
# 2. OPTIONAL: an AI model. Without one the app still works, using the rules reader.
#    Add at least one free key, then apply it with:  docker compose up -d
#    Pick the model in the "AI model" menu at the top of the dashboard.
# =============================================================================
# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq runs open-source Llama models (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI GPT-4o mini through GitHub Models (free with a GitHub token that has "Models: read"):
#   https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Fully local, open-source Llama through Ollama (no key, nothing leaves your machine):
#   docker compose --profile ollama up -d
#   docker compose exec ollama ollama pull llama3.1:8b
# then uncomment the next line and run:  docker compose --profile ollama up -d
# OLLAMA_BASE_URL=http://ollama:11434

# Other free providers the agent also supports:
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# The order models are tried in when you have not picked one. "heuristic" (rules) is always last.
# LLM_PROVIDERS=gemini,groq,github,cerebras,openrouter,mistral,ollama,heuristic
# Change a model name with <PROVIDER>_MODEL, for example:
# GEMINI_MODEL=gemini-flash-lite-latest
# GROQ_MODEL=openai/gpt-oss-120b
# OLLAMA_MODEL=qwen2.5:7b

# =============================================================================
# 3. Local defaults. Fine as they are for trying the app on your own computer.
# =============================================================================
# Shared secret between the gateway and the agent.
INTERNAL_API_KEY=change-me-long-random-string
# Signs session cookies (at least 32 characters).
JWT_SECRET=change-me-at-least-32-random-characters-long
# How often new mail is checked in the background, in seconds. 0 turns it off.
# AUTO_SYNC_INTERVAL_S=120
# Where the browser lands after sign-in, and where Google redirects back to.
# WEB_APP_URL=http://localhost:5173
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# =============================================================================
# 4. Only when running the services from source instead of Docker
#    (127.0.0.1 rather than "localhost": on Windows the Python agent hangs on IPv6 localhost)
# =============================================================================
DATABASE_URL=postgresql://inboxpilot:inboxpilot@127.0.0.1:5432/inboxpilot
REDIS_URL=redis://127.0.0.1:6379/0
AGENT_URL=http://127.0.0.1:8000
# EXTRACT_BATCH_SIZE=6
# EXTRACT_CONCURRENCY=3
# LLM_TIMEOUT_S=25
# SYNC_MAX_EMAILS=50
# SYNC_CHUNK_SIZE=12
# PORT=4000
